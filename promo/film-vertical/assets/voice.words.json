 "offset": 0,
 "duration": 38.571,
 "sentences": [
  {
   "text": "Vingt heures.",
   "start": 0,
   "end": 0.737
  },
  {
   "text": "Le cahier est ouvert… et personne ne comprend.",
   "start": 0.987,
   "end": 3.2
  },
  {
   "text": "Avec Klas deux-trois-sept, l'école et la maison avancent ensemble, du SIL à la Terminale.",
   "start": 3.45,
   "end": 8.572
  },
  {
   "text": "Parents : vous savez quoi faire ce soir.",
   "start": 8.822,
   "end": 10.652
  },
  {
   "text": "Dix minutes, un petit exercice, et des progrès qu'on voit enfin.",
   "start": 10.902,
   "end": 14.453
  },
  {
   "text": "Une leçon bloque ?",
   "start": 14.703,
   "end": 15.823
  },
  {
   "text": "L'assistant l'explique autrement, avec des exemples d'ici : le marché, les francs CFA, le football.",
   "start": 16.073,
   "end": 22.203
  },
  {
   "text": "Enseignants : l'appel en trente secondes, les notes, les bulletins, et le programme toujours sous les yeux.",
   "start": 22.453,
   "end": 27.448
  },
  {
   "text": "Élèves : des indices, pas des réponses.",
   "start": 27.698,
   "end": 29.611
  },
  {
   "text": "Sept jours gratuits, puis dès deux mille francs CFA par mois, avec Orange Money ou MTN MoMo.",
   "start": 29.86,
   "end": 35.122
  },
  {
   "text": "Klas deux-trois-sept.",
   "start": 35.372,
   "end": 36.506
  },
  {
   "text": "De petits pas, de grandes réussites.",
   "start": 36.756,
   "end": 38.57
  }
 ],
