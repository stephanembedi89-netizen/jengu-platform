 "duration": 50.984,
 "sentences": [
  {
   "text": "Vingt heures.",
   "start": 0,
   "end": 0.737
  },
  {
   "text": "La petite tend son cahier : « Papa, aide-moi.",
   "start": 1.337,
   "end": 3.507
  },
  {
   "text": "» Papa regarde… regarde encore… « Euh… va demander à ta mère.",
   "start": 4.107,
   "end": 7.358
  },
  {
   "text": "Maman sourit… et ouvre Klasse deux-trois-sept.",
   "start": 7.958,
   "end": 10.214
  },
  {
   "text": "Du SIL à la Terminale, l'école et la maison avancent ensemble.",
   "start": 10.815,
   "end": 14.575
  },
  {
   "text": "Ce soir, dix minutes, un petit exercice, on fait ça ensemble… et les progrès se voient, matière par matière.",
   "start": 15.175,
   "end": 21.398
  },
  {
   "text": "La leçon bloque encore ?",
   "start": 21.998,
   "end": 23.338
  },
  {
   "text": "L'assistant l'explique autrement : au marché, huit tomates, quatre cents francs… Même papa a compris !",
   "start": 23.937,
   "end": 28.997
  },
  {
   "text": "À l'école, l'enseignant suit tout : l'appel en trente secondes, les notes, et le programme toujours à jour.",
   "start": 29.597,
   "end": 34.872
  },
  {
   "text": "Et le grand frère, au lycée, révise seul : des indices… pas les réponses.",
   "start": 35.472,
   "end": 39.417
  },
  {
   "text": "Sept jours gratuits, puis dès deux mille francs CFA par mois, par Orange Money ou MTN MoMo.",
   "start": 40.018,
   "end": 45.103
  },
  {
   "text": "Klasse deux-trois-sept : maintenant, c'est papa qui explique.",
   "start": 45.702,
   "end": 48.595
  },
  {
   "text": "De petits pas… de grandes réussites.",
   "start": 49.195,
   "end": 50.984
  }
 ],
