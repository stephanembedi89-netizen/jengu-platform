// JenguAssur — Schéma Prisma multi-tenant pour assurances Douala
// Conforme CIMA (Code des Assurances Africain)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── TENANT (Compagnie d'assurance) ─────────────────────────────────────────

model Tenant {
  id             String   @id @default(cuid())
  nom            String
  sigle          String?
  email          String   @unique
  telephone      String?
  adresse        String?
  arrondissement String?
  ville          String   @default("Douala")
  pays           String   @default("Cameroun")
  logoUrl        String?
  agrementCima   String?
  typeStructure  String   @default("COURTIER")

  // SaaS — STARTER | PRO | ENTERPRISE
  plan           String   @default("STARTER")
  billingCycle   String   @default("MONTHLY")
  trialEndsAt    DateTime?
  subscriptionAt DateTime?
  isActive       Boolean  @default(true)

  users          User[]
  agents         Agent[]
  prospects      Prospect[]
  contrats       Contrat[]
  sinistres      Sinistre[]
  produits       Produit[]
  activites      Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ─── UTILISATEURS ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  nom          String
  prenom       String
  telephone    String?
  avatarUrl    String?
  // SUPER_ADMIN | ADMIN | SUPERVISEUR | AGENT
  role         String   @default("AGENT")
  isActive     Boolean  @default(true)

  agentId      String?  @unique
  agent        Agent?   @relation(fields: [agentId], references: [id])

  sessions     Session[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─── AGENTS COMMERCIAUX ───────────────────────────────────────────────────────

model Agent {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matricule       String?
  nom             String
  prenom          String
  email           String?
  telephone       String
  zone            String?
  objectifMensuel Float?
  tauxCommission  Float    @default(10)
  isActif         Boolean  @default(true)

  user        User?
  prospects   Prospect[]
  contrats    Contrat[]
  sinistres   Sinistre[]
  activites   Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, telephone])
  @@index([tenantId])
}

// ─── PRODUITS D'ASSURANCE ────────────────────────────────────────────────────

model Produit {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // AUTO | VIE | MALADIE | HABITATION | RC_PRO | VOYAGE | INCENDIE | TRANSPORT | AUTRE
  type        String
  nom         String
  description String?
  primeMin    Float
  primeMax    Float?
  isActif     Boolean  @default(true)

  contrats    Contrat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── PROSPECTS ───────────────────────────────────────────────────────────────

model Prospect {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id])

  // PHYSIQUE | MORALE
  typePersonne    String   @default("PHYSIQUE")
  nom             String
  prenom          String?
  raisonSociale   String?
  email           String?
  telephone       String
  adresse         String?
  arrondissement  String?
  quartier        String?
  profession      String?
  // NOUVEAU | CONTACTE | INTERESSE | DEVIS_ENVOYE | RELANCE | CONVERTI | PERDU
  statut          String   @default("NOUVEAU")
  // AUTO | VIE | MALADIE | HABITATION | RC_PRO | VOYAGE | INCENDIE | TRANSPORT | AUTRE
  produitInteret  String?
  noteInterne     String?
  prochainContact DateTime?

  devis       Devis[]
  activites   Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, agentId])
  @@index([tenantId, statut])
}

// ─── DEVIS ───────────────────────────────────────────────────────────────────

model Devis {
  id          String   @id @default(cuid())
  tenantId    String
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id])
  numero      String
  typeProduit String
  primeHT     Float
  taxes       Float    @default(0)
  primeTTC    Float
  duree       Int
  // BROUILLON | ENVOYE | ACCEPTE | REFUSE | EXPIRE
  statut      String   @default("BROUILLON")
  validUntil  DateTime?
  notes       String?

  contrat     Contrat?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([prospectId])
}

// ─── CONTRATS ────────────────────────────────────────────────────────────────

model Contrat {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id])
  produitId       String?
  produit         Produit? @relation(fields: [produitId], references: [id])
  devisId         String?  @unique
  devis           Devis?   @relation(fields: [devisId], references: [id])

  nomAssure       String
  prenomAssure    String?
  telephoneAssure String
  emailAssure     String?

  numero          String
  typeProduit     String
  primeAnnuelle   Float
  primeNette      Float
  taxesCima       Float    @default(0)
  commission      Float    @default(0)
  // ACTIF | SUSPENDU | EN_ATTENTE_PAIEMENT | RESILIE | EXPIRE | RENOUVELE
  statut          String   @default("ACTIF")
  dateEffet       DateTime
  dateEcheance    DateTime
  renouvAuto      Boolean  @default(true)
  notes           String?

  sinistres   Sinistre[]
  paiements   Paiement[]
  activites   Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, agentId])
  @@index([tenantId, statut])
  @@index([dateEcheance])
}

// ─── PAIEMENTS ───────────────────────────────────────────────────────────────

model Paiement {
  id           String   @id @default(cuid())
  contratId    String
  contrat      Contrat  @relation(fields: [contratId], references: [id])
  montant      Float
  // CASH | MOBILE_MONEY | VIREMENT | CHEQUE
  mode         String   @default("MOBILE_MONEY")
  reference    String?
  // EN_ATTENTE | RECU | ECHEC
  statut       String   @default("EN_ATTENTE")
  datePaiement DateTime?
  notes        String?

  createdAt DateTime @default(now())

  @@index([contratId])
}

// ─── SINISTRES ───────────────────────────────────────────────────────────────

model Sinistre {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratId        String
  contrat          Contrat  @relation(fields: [contratId], references: [id])
  agentId          String
  agent            Agent    @relation(fields: [agentId], references: [id])

  numero           String
  dateSinistre     DateTime
  lieuSinistre     String?
  description      String
  // FAIBLE | MOYEN | ELEVE | CATASTROPHE
  gravite          String   @default("MOYEN")
  // DECLARE | EN_INSTRUCTION | EXPERTISE_EN_COURS | INDEMNISE | REJETE | CLOS
  statut           String   @default("DECLARE")
  montantDeclare   Float?
  montantIndemnise Float?
  dateReglement    DateTime?
  notes            String?

  activites   Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, statut])
  @@index([contratId])
}

// ─── ACTIVITÉS / JOURNAL ──────────────────────────────────────────────────────

model Activite {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?   @relation(fields: [agentId], references: [id])
  // APPEL | EMAIL | VISITE | DEVIS_CREE | CONTRAT_SIGNE | PAIEMENT_RECU | SINISTRE_DECLARE | RELANCE_RENOUVELLEMENT | NOTE
  type        String
  description String
  prospectId  String?
  prospect    Prospect? @relation(fields: [prospectId], references: [id])
  contratId   String?
  contrat     Contrat?  @relation(fields: [contratId], references: [id])
  sinistreId  String?
  sinistre    Sinistre? @relation(fields: [sinistreId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([agentId])
}
