// JenguAssur — Schéma Prisma multi-tenant pour assurances Douala
// Conforme CIMA (Code des Assurances Africain)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── PLANS SAAS ──────────────────────────────────────────────────────────────

enum PlanType {
  STARTER    // 15 000 XAF/mois — 5 agents max
  PRO        // 45 000 XAF/mois — 25 agents max
  ENTERPRISE // 120 000 XAF/mois — illimité
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

// ─── TENANT (Compagnie d'assurance) ─────────────────────────────────────────

model Tenant {
  id             String   @id @default(cuid())
  nom            String
  sigle          String?
  email          String   @unique
  telephone      String?
  adresse        String?
  arrondissement String?  // Douala I à VI
  ville          String   @default("Douala")
  pays           String   @default("Cameroun")
  logoUrl        String?
  agrementCima   String?  // Numéro agrément CIMA
  typeStructure  StructureType @default(COURTIER)

  // SaaS
  plan           PlanType     @default(STARTER)
  billingCycle   BillingCycle @default(MONTHLY)
  trialEndsAt    DateTime?
  subscriptionAt DateTime?
  isActive       Boolean      @default(true)

  // Relations
  users          User[]
  agents         Agent[]
  prospects      Prospect[]
  contrats       Contrat[]
  sinistres      Sinistre[]
  produits       Produit[]
  activites      Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum StructureType {
  COMPAGNIE   // Compagnie d'assurance (Activa, Chanas, Saham...)
  COURTIER    // Courtier en assurances
  AGENT_GENERAL // Agent général
  MANDATAIRE  // Mandataire exclusif
}

// ─── UTILISATEURS ────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN  // Admin JenguAssur (interne)
  ADMIN        // Admin compagnie
  SUPERVISEUR  // Chef d'équipe
  AGENT        // Agent commercial
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  nom          String
  prenom       String
  telephone    String?
  avatarUrl    String?
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true)

  // Lien optionnel à un agent
  agentId      String?  @unique
  agent        Agent?   @relation(fields: [agentId], references: [id])

  sessions     Session[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─── AGENTS COMMERCIAUX ───────────────────────────────────────────────────────

model Agent {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matricule      String?
  nom            String
  prenom         String
  email          String?
  telephone      String
  zone           String?  // Arrondissement/quartier couvert
  objectifMensuel Float?  // en XAF
  tauxCommission  Float   @default(10) // %
  isActif        Boolean  @default(true)

  user           User?
  prospects      Prospect[]
  contrats       Contrat[]
  sinistres      Sinistre[]
  activites      Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, telephone])
  @@index([tenantId])
}

// ─── PRODUITS D'ASSURANCE ────────────────────────────────────────────────────

enum TypeProduit {
  AUTO          // Assurance automobile
  VIE           // Assurance vie
  MALADIE       // Assurance maladie / santé
  HABITATION    // Multirisque habitation
  RC_PRO        // Responsabilité civile professionnelle
  VOYAGE        // Assurance voyage
  INCENDIE      // Incendie et risques divers
  TRANSPORT     // Transport de marchandises
  AUTRE
}

model Produit {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        TypeProduit
  nom         String
  description String?
  primeMin    Float       // Prime minimale XAF
  primeMax    Float?      // Prime maximale XAF
  isActif     Boolean     @default(true)

  contrats    Contrat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── PROSPECTS ───────────────────────────────────────────────────────────────

enum StatutProspect {
  NOUVEAU
  CONTACTE
  INTERESSE
  DEVIS_ENVOYE
  RELANCE
  CONVERTI     // Devenu client
  PERDU
}

enum TypePersonne {
  PHYSIQUE
  MORALE       // Entreprise
}

model Prospect {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId         String
  agent           Agent          @relation(fields: [agentId], references: [id])

  typePersonne    TypePersonne   @default(PHYSIQUE)
  nom             String
  prenom          String?
  raisonSociale   String?        // Si personne morale
  email           String?
  telephone       String
  adresse         String?
  arrondissement  String?
  quartier        String?
  profession      String?
  statut          StatutProspect @default(NOUVEAU)
  produitInteret  TypeProduit?
  noteInterne     String?
  prochainContact DateTime?

  devis           Devis[]
  activites       Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, agentId])
  @@index([tenantId, statut])
}

// ─── DEVIS ───────────────────────────────────────────────────────────────────

enum StatutDevis {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
}

model Devis {
  id           String      @id @default(cuid())
  tenantId     String
  prospectId   String
  prospect     Prospect    @relation(fields: [prospectId], references: [id])
  numero       String      // DEV-2024-0001
  typeProduit  TypeProduit
  primeHT      Float       // en XAF
  taxes        Float       @default(0)
  primeTTC     Float       // en XAF
  duree        Int         // en mois
  statut       StatutDevis @default(BROUILLON)
  validUntil   DateTime?
  notes        String?

  contrat      Contrat?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([prospectId])
}

// ─── CONTRATS ────────────────────────────────────────────────────────────────

enum StatutContrat {
  ACTIF
  SUSPENDU
  EN_ATTENTE_PAIEMENT
  RESILIE
  EXPIRE
  RENOUVELE
}

model Contrat {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId         String
  agent           Agent         @relation(fields: [agentId], references: [id])
  produitId       String?
  produit         Produit?      @relation(fields: [produitId], references: [id])
  devisId         String?       @unique
  devis           Devis?        @relation(fields: [devisId], references: [id])

  // Assuré
  nomAssure       String
  prenomAssure    String?
  telephoneAssure String
  emailAssure     String?

  numero          String        // POL-2024-0001
  typeProduit     TypeProduit
  primeAnnuelle   Float         // en XAF
  primeNette      Float
  taxesCima       Float         @default(0)   // Taxes CIMA
  commission      Float         @default(0)   // Commission agent XAF
  statut          StatutContrat @default(ACTIF)
  dateEffet       DateTime
  dateEcheance    DateTime
  renouvAuto      Boolean       @default(true)
  notes           String?

  sinistres       Sinistre[]
  paiements       Paiement[]
  activites       Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, agentId])
  @@index([tenantId, statut])
  @@index([dateEcheance])
}

// ─── PAIEMENTS ───────────────────────────────────────────────────────────────

enum ModePaiement {
  CASH
  MOBILE_MONEY   // MTN MoMo, Orange Money
  VIREMENT
  CHEQUE
}

enum StatutPaiement {
  EN_ATTENTE
  RECU
  ECHEC
}

model Paiement {
  id           String         @id @default(cuid())
  contratId    String
  contrat      Contrat        @relation(fields: [contratId], references: [id])
  montant      Float          // XAF
  mode         ModePaiement   @default(MOBILE_MONEY)
  reference    String?
  statut       StatutPaiement @default(EN_ATTENTE)
  datePaiement DateTime?
  notes        String?

  createdAt DateTime @default(now())

  @@index([contratId])
}

// ─── SINISTRES ───────────────────────────────────────────────────────────────

enum StatutSinistre {
  DECLARE
  EN_INSTRUCTION
  EXPERTISE_EN_COURS
  INDEMNISE
  REJETE
  CLOS
}

enum GraviteSinistre {
  FAIBLE
  MOYEN
  ELEVE
  CATASTROPHE
}

model Sinistre {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratId      String
  contrat        Contrat         @relation(fields: [contratId], references: [id])
  agentId        String
  agent          Agent           @relation(fields: [agentId], references: [id])

  numero         String          // SIN-2024-0001
  dateSinistre   DateTime
  lieuSinistre   String?
  description    String
  gravite        GraviteSinistre @default(MOYEN)
  statut         StatutSinistre  @default(DECLARE)
  montantDeclare Float?          // XAF
  montantIndemnise Float?        // XAF
  dateReglement  DateTime?
  notes          String?

  activites      Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, statut])
  @@index([contratId])
}

// ─── ACTIVITÉS / JOURNAL ──────────────────────────────────────────────────────

enum TypeActivite {
  APPEL
  EMAIL
  VISITE
  DEVIS_CREE
  CONTRAT_SIGNE
  PAIEMENT_RECU
  SINISTRE_DECLARE
  RELANCE_RENOUVELLEMENT
  NOTE
}

model Activite {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?       @relation(fields: [agentId], references: [id])
  type        TypeActivite
  description String
  prospectId  String?
  prospect    Prospect?    @relation(fields: [prospectId], references: [id])
  contratId   String?
  contrat     Contrat?     @relation(fields: [contratId], references: [id])
  sinistreId  String?
  sinistre    Sinistre?    @relation(fields: [sinistreId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([agentId])
}
