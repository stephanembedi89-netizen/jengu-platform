# Base de données (SQLite pour dev, PostgreSQL pour prod)
DATABASE_URL="file:./dev.db"
# Pour production PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/jenguassur?schema=public"

# Sécurité JWT — OBLIGATOIRE en production
JWT_SECRET="change-this-to-a-random-64-char-string-in-production"

# Anthropic / Claude AI (pour l'assistant IA optionnel)
ANTHROPIC_API_KEY="sk-ant-..."

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
