# Base de données PostgreSQL (Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/jenguassur?schema=public&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host:5432/jenguassur?schema=public"

# Sécurité JWT — OBLIGATOIRE en production
JWT_SECRET="change-this-to-a-random-64-char-string-in-production"

# Anthropic / Claude AI (pour l'assistant JenguAI)
ANTHROPIC_API_KEY="sk-ant-..."

# Application
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NODE_ENV="production"
